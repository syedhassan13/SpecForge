# Copy to .env and fill in. Never commit .env.

# OpenAI (gpt-4o-mini-2024-07-18 is used in all experiments)
OPENAI_API_KEY=sk-...

# Optional open-weight model through any OpenAI-compatible endpoint
# (DeepSeek, OpenRouter, Together, Groq, HF router). Refer to it as
# "open:<OPEN_MODEL_NAME>" in --models or in a config file.
OPEN_MODEL_NAME=
OPEN_MODEL_BASE_URL=
OPEN_MODEL_API_KEY=
OPEN_MODEL_JSON_SCHEMA=0

# Dafny 4.x executable (download from github.com/dafny-lang/dafny/releases)
DAFNY_PATH=dafny
